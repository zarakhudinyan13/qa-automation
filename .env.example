# Application URL (no trailing slash)
BASE_URL=https://automationexercise.com

# Registered test user — create an account at https://automationexercise.com/signup
EMAIL=your.email@example.com
PASSWORD=YourPassword123

# Display name shown after login (matches signup name)
USER_NAME=Test User

# Optional. tests/mail skips the live mailbox check when these are empty.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
