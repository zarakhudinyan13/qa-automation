# Local names. GitHub Actions uses the secret names in the comments.

# Application URL (no trailing slash). Not a secret.
BASE_URL=https://automationexercise.com

# Registered test user — create an account at https://automationexercise.com/signup
# GitHub: TEST_EMAIL, TEST_PASSWORD, TEST_USER_NAME
EMAIL=your.email@example.com
PASSWORD=YourPassword123
USER_NAME=Test User

# Optional. The live mailbox test skips when these are empty.
# GitHub: IMAP_HOST, IMAP_PORT, IMAP_USER, IMAP_PASSWORD, IMAP_MAILBOX
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
