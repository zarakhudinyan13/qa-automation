{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright automation course project for automationexercise.com",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:auth": "playwright test --project=setup --project=chromium-auth",
    "test:examples": "playwright test --project=examples",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "auth:setup": "playwright test --project=setup"
  },
  "keywords": ["playwright", "automation", "testing", "pom"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
