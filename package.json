{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright tests for automationexercise.com",
  "main": "index.js",
  "scripts": {
    "auth:setup": "playwright test --project=setup",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:ui:headed": "playwright test --project=chromium --headed",
    "test:ui:debug": "playwright test --project=chromium --debug",
    "test:auth": "playwright test --project=setup --project=chromium-auth",
    "test:examples": "playwright test --project=two-contexts",
    "test:mail": "playwright test --project=mail",
    "test:auth:headed": "playwright test --project=setup --project=chromium-auth --headed",
    "test:ci": "playwright test --workers=2",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "install:browsers": "playwright install chrome",
    "exam": "node scripts/open-in-chrome.js lessons/exam.html"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing"
  ],
  "author": "Zara Khudinyan",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "imapflow": "^2.2.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
